{
  "name": "dsh-rsi",
  "version": "1.5.0",
  "type": "module",
  "description": "Recursive self-improvement for DeepSeek Harness: plan repeated probe runs, compare variants, score with tamper-checked rubrics, audit writes, adopt behind smoke checks and rollback, then review every workspace's evidence and lessons in one global sidebar overview with a cross-workspace experience ledger.",
  "engines": {
    "dsh": "^0.2.3-alpha.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "test/*.test.mjs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "rsi",
    "recursive-self-improvement",
    "self-improvement",
    "harness",
    "agent",
    "propose-probe-compose"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bert0000000000/dsh-rsi.git"
  },
  "homepage": "https://github.com/Bert0000000000/dsh-rsi#readme",
  "bugs": {
    "url": "https://github.com/Bert0000000000/dsh-rsi/issues"
  }
}
